{
  "title": "3.6.8 选取 x_0∈[0,2]",
  "blocks": [
    {
      "type": "paragraph",
      "text": "3.6.8 选取 \\(x_0 \\in [0,2]\\)"
    },
    {
      "type": "display_formula",
      "latex": "\\because\\quad f(x_1)=f(x_0)+f'(x_0)(x_1-x_0)+\\frac{f''(\\xi_1)}{2!}(x_1-x_0)^2"
    },
    {
      "type": "display_formula",
      "latex": "f(x_2)=f(x_0)+f'(x_0)(x_2-x_0)+\\frac{f''(\\xi_2)}{2!}(x_2-x_0)^2"
    },
    {
      "type": "paragraph",
      "text": "令 \\(x_1=0,\\ x_2=2\\)"
    },
    {
      "type": "display_formula",
      "latex": "f(0)=f(x_0)+f'(x_0)(-x_0)+\\frac{f''(\\xi_1)}{2!}(-x_0)^2"
    },
    {
      "type": "display_formula",
      "latex": "f(2)=f(x_0)+f'(x_0)(2-x_0)+\\frac{f''(\\xi_2)}{2!}(2-x_0)^2"
    },
    {
      "type": "display_formula",
      "latex": "\\Rightarrow\\quad 2|f(x_0)|\\le |f(0)|+|f(2)|+\\cdots"
    },
    {
      "type": "display_formula",
      "latex": "\\le 4"
    },
    {
      "type": "display_formula",
      "latex": "\\Rightarrow\\quad |f(x_0)|\\le 2"
    },
    {
      "type": "page_break"
    },
    {
      "type": "paragraph",
      "text": "10月26号"
    },
    {
      "type": "display_formula",
      "latex": "x^3-x^2+x^2+x-x+3x-3+4"
    },
    {
      "type": "display_formula",
      "latex": "\\text{3.6.1. (1)}\\quad y=x^2+x+3+\\frac{4}{x-1}"
    },
    {
      "type": "display_formula",
      "latex": "y'=2x+1+\\frac{-4}{(x-1)^2}"
    },
    {
      "type": "display_formula",
      "latex": "\\therefore y=-1-3x+5x^2-4x^3+"
    },
    {
      "type": "display_formula",
      "latex": "-+\\frac{4(-1)^n}{(x+1)^{n+1}}x^n"
    },
    {
      "type": "display_formula",
      "latex": "y''=2+\\frac{8}{(x-1)^3}"
    },
    {
      "type": "display_formula",
      "latex": "y'''=\\frac{-24}{(x-1)^4}"
    },
    {
      "type": "display_formula",
      "latex": "y^{(n)}=\\frac{4(-1)^n\\cdot n!}{(x-1)^{n+1}}"
    },
    {
      "type": "display_formula",
      "latex": "(2)\\quad y'=2\\sin x\\cos x=\\sin 2x"
    },
    {
      "type": "display_formula",
      "latex": "y''=2\\cdot\\sin\\left(2x+\\frac{\\pi}{2}\\right)"
    },
    {
      "type": "display_formula",
      "latex": "y'''=2^2\\sin(2x+\\pi)"
    },
    {
      "type": "display_formula",
      "latex": "\\therefore y=0+0+x+\\cdots-\\frac{2^n\\sin(2x+n\\frac{\\pi}{2})}{n!}\\cdot x^n"
    },
    {
      "type": "display_formula",
      "latex": "\\text{3.6.2 解：}\\quad y=1+\\sin x+\\frac{\\sin^2 x}{2!}+\\frac{\\sin^3 x}{3!}+\\cdots"
    },
    {
      "type": "display_formula",
      "latex": "\\sin x=x-\\frac{1}{3!}x^3"
    },
    {
      "type": "display_formula",
      "latex": "y=1+x-\\frac{1}{6}x^3+\\frac{1}{2}\\cdot\\left(x-\\frac{1}{6}x^3\\right)^2+"
    },
    {
      "type": "display_formula",
      "latex": "\\frac{1}{6}\\cdot\\left(x-\\frac{1}{6}x^3\\right)^3"
    },
    {
      "type": "display_formula",
      "latex": "=1+x+\\frac{1}{2}x^2+o(x^3)"
    },
    {
      "type": "display_formula",
      "latex": "\\text{3.6.3.}\\quad \\ln(x+1)=x-\\frac{1}{2}x^2+\\frac{1}{3}x^3-\\frac{1}{4}x^4+\\frac{1}{5}x^5-\\frac{1}{6}x^6"
    },
    {
      "type": "display_formula",
      "latex": "\\cos x=1-\\frac{1}{2}x^2+\\frac{1}{24}x^4-\\frac{1}{720}x^6"
    }
  ]
}
