OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30
FULLPAGE_TIMEOUT_SECONDS=120
FULLPAGE_MAX_TOKENS=24000
# 多页整页识别的并行页数，1~10，默认 3。调大更快，但更容易撞网关限流。
# WORKBENCH_PAGE_CONCURRENCY=3
# 过期任务保留天数，默认 7；填 0 表示永不清理。
# WORKBENCH_JOB_MAX_AGE_DAYS=7
# 过期任务清理线程总开关，默认 on。设成 off 就完全不起这个线程（调试时用）。
# WORKBENCH_JOB_CLEANUP=on
# 工作台监听端口，默认 8760。被占用时会自动往后找空位，这个值只是首选。
# WORKBENCH_PORT=8760
# 本机默认 GPU。没有 NVIDIA GPU 时改成：
#   RECOGNIZER_MODEL=PP-FormulaNet-L
#   RECOGNIZER_MODEL_DIR=models/PP-FormulaNet-L
#   RECOGNIZER_DEVICE=cpu
# 并用 -Cpu 启动画板。
RECOGNIZER_MODEL=UniMERNet
RECOGNIZER_MODEL_DIR=models/UniMERNet
RECOGNIZER_DEVICE=gpu:0
# 识别后端，默认 paddle。设成 mock 返回明确失败候选，仅供联调，
# 不得当成真实识别结果。
# RECOGNIZER_BACKEND=paddle
# 默认按 RECOGNIZER_MODEL 选引擎；也可显式指定多个独立模型同时跑，
# 例如 "pp_formulanet_l,unimernet"（慢，但候选之间相互独立）。
# RECOGNIZER_ENGINES=unimernet
# 多视角识别，默认 off。设 on 会慢 3~5 倍，用于疑难样本。
# RECOGNIZER_VIEWS=off
# 去重后的候选数上限，默认 6。调大更全，但会让下游仲裁的 token 消耗上升。
# RECOGNIZER_MAX_CANDIDATES=6
# 设成文件路径则每次识别追加一行 JSON，供做测试集分析。
# RECOGNIZER_LOG_JSONL=
PADDLE_PDX_CACHE_HOME=.paddlex
# ctex 字体集，默认 windows；无系统 CJK 字体的环境（Linux/macOS/CI）可设 fandol
LATEX_FONTSET=windows
